$body = @{
    scenarioId = "scenario-B"
    copilotAnswer = "Shift route 500m from the sensitive zone to reduce acoustic impact by approximately 25%."
} | ConvertTo-Json

Invoke-RestMethod `
    -Uri "http://localhost:5000/api/report" `
    -Method Post `
    -ContentType "application/json" `
    -Body $body